    videoEventId: 
  - speaker: 1
    kind: 0
    text: "You just can\u2019t Eugh, never say \u2018lol\u2019 out loud ever again
      dude, that\u2019s just horrible. "
    videoEventId: 
  - speaker: 2
    kind: 0
    text: "You just can\u2019t handle my swag broski. Anyway, what\u2019d he actually
