  leftCharacter: {fileID: 11400000, guid: 35b3862c7a99b7943befeb5d72936a30, type: 2}
  rightCharacter: {fileID: 11400000, guid: 46fc80e9d423d604bbd186abe15d6617, type: 2}
  middleCharacter: {fileID: 11400000, guid: edef32ed334b61d4d95629e4f36b237e, type: 2}
  narrator: 0
